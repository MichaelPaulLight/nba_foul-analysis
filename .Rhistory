library(tidyverse)
library(brms)
library(SBC)
library(tidybayes)
library(loo)
source(here::here("00_R", "simulate_shots_2.R"))
small_sim <- simulate_shots(n_observations = 500, n_defenders = 50, n_teams = 5)
small_sim_standardized <- simulate_shots(n_observations = 500, n_defenders = 50, n_teams = 5, foul_count_transform = "standardized")
small_sim_unsummarized <- simulate_shots(n_observations = 500, n_defenders = 50, n_teams = 10, summarize_data = "FALSE")
small_sim_factor <- simulate_shots(n_observations = 150, n_defenders = 50, n_teams = 5, foul_count_transform = "ordered")
foul_binomial_formula_varying_slopes_mo_2 <- bf(
shots_made | trials(shots_taken) ~
1 + mo(defender_foul_count) +
(1 + mo(defender_foul_count) | shot_movement) +
(1 + mo(defender_foul_count) | shot_distance_category) +
(1 + mo(defender_foul_count) | position) +
(1 + mo(defender_foul_count) | defender_id) +
(1 + mo(defender_foul_count) | defensive_team_id) +
(1 | offensive_team_id)
)
prior_custom_vs_mo <- c(
prior(normal(0, 1), class = "Intercept"),  # Fixed effects, weakly regularizing
prior(normal(0.2, 0.5), class = "b", coef = "modefender_foul_count"), # Likely positive effect, likely small
prior(exponential(1), class = "sd"),
prior(dirichlet(c(1, 1, 1, 1.5, 1.5)), class = "simo", coef = "modefender_foul_count1"),
prior(lkj(2), class = "cor")
)
generator_foul_binomial_formula_vs_mo_custom_prior <- SBC_generator_brms(formula = foul_binomial_formula_varying_slopes_mo_2, family = binomial(link = "logit"), data = small_sim_factor, prior = prior_custom_vs_mo, backend = "cmdstanr",
thin = 50, warmup = 10000, refresh = 2000,
out_stan_file = file.path("brms-generator_binomial_vs-mo_custom-priors.stan")
)
set.seed(42)
datasets <- generate_datasets(generator_foul_binomial_formula_vs_mo_custom_prior, 500)
options(mc.cores = parallel::detectCores())
# Enabling parallel processing via future
library(future)
plan(multisession)
options(SBC.min_chunk_size = 5)
prior_sd <- calculate_prior_sd(datasets)
backend <- SBC_backend_brms_from_generator(generator_foul_binomial_formula_vs_mo_custom_prior, chains = 1, thin = 1,
warmup = 500, iter = 1500,
inits = 0.1)
results_500_vs_mo <- compute_SBC(datasets, backend,
cache_mode = "results",
cache_location = file.path("results_foul_binomial_formula_vs-mo_custom_prior_500"))
plot_rank_hist(results_500_vs_mo)
plot_ecdf_diff(results_500_vs_mo)
