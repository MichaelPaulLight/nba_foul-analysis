This notebook fits three models of varying complexity to simulated datasets using brms default priors

```{r}
small_sim <- simulate_shots(n_observations = 1000, n_defenders = 50, n_teams = 10)

small_sim_standardized <- simulate_shots(n_observations = 1000, n_defenders = 50, n_teams = 10, foul_count_transform = "standardized")

small_sim_unsummarized <- simulate_shots(n_observations = 1000, n_defenders = 50, n_teams = 10, summarize_data = "FALSE")

small_sim_factor <- simulate_shots(n_observations = 1000, n_defenders = 50, n_teams = 10, foul_count_transform = "ordered")
```

Defining a binomial model of foul effects on shotmaking, simplest to most-complex

```{r}
foul_binomial_formula_simple <- bf(
  shots_made | trials(shots_taken) ~ 
    1 + defender_foul_count
)

foul_binomial_formula_varying_intercepts <- bf(
  shots_made | trials(shots_taken) ~ 
    1 + defender_foul_count +
    (1 | shot_distance_category) +
    (1 | defensive_team_id) +
    (1 | position) +
    (1 | defender_id)
)

foul_binomial_formula_varying_slopes <- bf(
  shots_made | trials(shots_taken) ~ 
    1 + defender_foul_count +
    (1 + defender_foul_count | shot_distance_category) +
    (1 + defender_foul_count | defensive_team_id) +
    (1 + defender_foul_count | position) + 
    (1 + defender_foul_count | defender_id)
)

foul_binomial_formula_simple_mo <- bf(
  shots_made | trials(shots_taken) ~ 
    1 + mo(defender_foul_count)
)

foul_binomial_formula_varying_intercepts_mo <- bf(
  shots_made | trials(shots_taken) ~ 
    1 + mo(defender_foul_count) +
    (1 | shot_distance_category) +
    (1 | defensive_team_id) +
    (1 | position) +
    (1 | defender_id)
)

foul_binomial_formula_varying_slopes_mo <- bf(
  shots_made | trials(shots_taken) ~ 
    1 + mo(defender_foul_count) +
    (1 + mo(defender_foul_count) | shot_distance_category) +
    (1 + mo(defender_foul_count) | defensive_team_id) +
    (1 + mo(defender_foul_count) | position) +
    (1 + defender_foul_count | defender_id)
)

```

```{r}
prior_default <- c(
  prior(normal(0, 1), class = "b"),  # Fixed effects
  prior(student_t(3, 0, 2.5), class = "Intercept") # Default brms
)

prior_custom_intercept <- c(
  prior(normal(0, 1), class = "b"),  # Fixed effects
  prior(normal(0, 1), class = "Intercept") # Custom
)
  
prior_default_mo <- c(
  prior(normal(0, 0.5), class = "b"),  # Fixed effects
  prior(student_t(3, 0, 2.5), class = "Intercept"), 
  prior(dirichlet(c(1, 1, 1, 2, 2)), class = "simo", coef = "modefender_foul_count1")
)
```

```{r}
foul_binomial_model_prior_default <- brm(
  formula = foul_binomial_formula_simple,
  data = small_sim,
  family = binomial(link = "logit"),
  prior = prior_default,
  sample_prior = "only",
  chains = 4,
  cores = 4,
  iter = 2000,
  warmup = 1000,
  seed = 42,
  control = list(adapt_delta = 0.95),
  backend = "cmdstanr"
)

foul_binomial_model_prior_standardized <- brm(
  formula = foul_binomial_formula_simple,
  data = small_sim_standardized,
  family = binomial(link = "logit"),
  prior = prior_default,
  sample_prior = "only",
  chains = 4,
  cores = 4,
  iter = 2000,
  warmup = 1000,
  seed = 42,
  control = list(adapt_delta = 0.95),
  backend = "cmdstanr"
)

foul_binomial_model_prior_mo <- brm(
  formula = foul_binomial_formula_simple_mo,
  data = small_sim_factor,
  family = binomial(link = "logit"),
  prior = prior_default_mo,
  sample_prior = "only",
  chains = 4,
  cores = 4,
  iter = 2000,
  warmup = 1000,
  seed = 42,
  control = list(adapt_delta = 0.95),
  backend = "cmdstanr"
)
```

```{r}
prior_predictions <- posterior_predict(foul_binomial_model_prior_default) 
prior_means <- colMeans(prior_predictions)

# Create a data frame for plotting
prior_plot_data <- data.frame(
  observed = small_sim$shots_made,
  predicted = prior_means,
  position = small_sim$position
)

# Plot prior predictions vs observed
ggplot(prior_plot_data, aes(x = observed, y = predicted, color = position)) +
  geom_point(alpha = 0.6) +
  geom_abline(intercept = 0, slope = 1, linetype = "dashed") +
  labs(title = "Prior Predictive Check",
       x = "Observed Shots Made",
       y = "Predicted Shots Made") +
  theme_minimal()

# Check prior distributions of key parameters
prior_draws <- as_draws_df(foul_binomial_model_prior_default)

# Plot prior distributions for fixed effects
ggplot(prior_draws, aes(x = b_defender_foul_count)) +
  geom_density(fill = "steelblue", alpha = 0.5) +
  labs(title = "Prior Distribution: Defender Foul Count Effect",
       x = "Effect Size",
       y = "Density") +
  theme_minimal()
