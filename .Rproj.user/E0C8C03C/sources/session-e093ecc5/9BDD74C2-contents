```{r}
generator_foul_binomial_formula_simple_default_prior <- SBC_generator_brms(formula = foul_binomial_formula_simple, family = binomial(link = "logit"), data = small_sim_standardized, prior = prior_default, backend = "cmdstanr", 
                                thin = 50, warmup = 10000, refresh = 2000,
                                out_stan_file = file.path("05-1_models/brms-generator_binomial_simple_default-priors.stan")
                                )

set.seed(42)

datasets <- generate_datasets(generator_foul_binomial_formula_simple_default_prior, 100)

prior_sd <- calculate_prior_sd(datasets)

backend <- SBC_backend_brms_from_generator(generator_foul_binomial_formula_simple_default_prior, chains = 1, thin = 1,
                            warmup = 500, iter = 1500,               
                            inits = 0.1)

results_100 <- compute_SBC(datasets, backend,
                    cache_mode = "results", 
                    cache_location = file.path("results_foul_binomial_formula_simple_default_prior"))

plot_rank_hist(results_100)

plot_ecdf_diff(results_100)

z_score_results_100 <- results_100$stats$z_score

contraction_result_100 <- 1 - (results_100$stats$sd / prior_sd)**2

# contraction vs. z score actually looks pretty good

plot(contraction_result_100, z_score_results_100, col=c("#8F272720"), lwd=2, pch=16, cex=0.8,
     xlim=c(0, 1), xlab="Posterior Contraction",
     ylim=c(-5, 5), ylab="Posterior z-Score")

results_100_default_stats_intercept <- results_100$stats |> filter(variable == "Intercept")   

z_score_results_100_default_intercept <- results_100_default_stats_intercept$z_score

contraction_result_100_default_intercept <- 1 - (results_100_default_stats_intercept$sd / prior_sd)**2

plot(contraction_result_100_default_intercept, z_score_results_100_default_intercept, col=c("#8F272720"), lwd=2, pch=16, cex=0.8,
     xlim=c(0, 1), xlab="Posterior Contraction",
     ylim=c(-5, 5), ylab="Posterior z-Score")
