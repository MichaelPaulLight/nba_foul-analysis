```{r}
library(tidyverse)
library(brms)
library(SBC)
library(tidybayes)
library(loo)
source(here::here("00_R", "simulate_shots.R"))
```

This notebook fits three models of varying complexity to simulated datasets using brms default priors

```{r}
small_sim <- simulate_shots(n_observations = 1000, n_defenders = 50, n_teams = 10)

small_sim_standardized <- simulate_shots(n_observations = 1000, n_defenders = 50, n_teams = 10, foul_count_transform = "standardized")

small_sim_factor <- simulate_shots(n_observations = 1000, n_defenders = 50, n_teams = 10, foul_count_transform = "ordered")
```

Defining a binomial model of foul effects on shotmaking, simplest to most-complex

```{r}
foul_binomial_formula_simple <- bf(
  shots_made | trials(shots_taken) ~ 
    1 + defender_foul_count
)

foul_binomial_formula_varying_intercepts <- bf(
  shots_made | trials(shots_taken) ~ 
    1 + defender_foul_count +
    (1 | shot_distance_category) +
    (1 | defensive_team_id) +
    (1 | position)
)

foul_binomial_formula_varying_slopes <- bf(
  shots_made | trials(shots_taken) ~ 
    1 + defender_foul_count +
    (1 + defender_foul_count | shot_distance_category) +
    (1 + defender_foul_count | defensive_team_id) +
    (1 + defender_foul_count | position)
)

foul_binomial_formula_simple_mo <- bf(
  shots_made | trials(shots_taken) ~ 
    1 + mo(defender_foul_count)
)

foul_binomial_formula_varying_intercepts_mo <- bf(
  shots_made | trials(shots_taken) ~ 
    1 + mo(defender_foul_count) +
    (1 | shot_distance_category) +
    (1 | defensive_team_id) +
    (1 | position)
)

foul_binomial_formula_varying_slopes_mo <- bf(
  shots_made | trials(shots_taken) ~ 
    1 + mo(defender_foul_count) +
    (1 + mo(defender_foul_count) | shot_distance_category) +
    (1 + mo(defender_foul_count) | defensive_team_id) +
    (1 + mo(defender_foul_count) | position)
)

```

```{r}
foul_binomial_model_default <- brm(
  formula = foul_binomial_formula_simple,
  data = small_sim,
  family = binomial(link = "logit"),
  chains = 4,
  cores = 4,
  iter = 2000,
  warmup = 1000,
  seed = 42,
  control = list(adapt_delta = 0.95),
  backend = "cmdstanr"
)

foul_binomial_model_standardized <- brm(
  formula = foul_binomial_formula_simple,
  data = small_sim_standardized,
  family = binomial(link = "logit"),
  chains = 4,
  cores = 4,
  iter = 2000,
  warmup = 1000,
  seed = 42,
  control = list(adapt_delta = 0.95),
  backend = "cmdstanr"
)

foul_binomial_model_mo <- brm(
  formula = foul_binomial_formula_simple_mo,
  data = small_sim_factor,
  family = binomial(link = "logit"),
  chains = 4,
  cores = 4,
  iter = 2000,
  warmup = 1000,
  seed = 42,
  control = list(adapt_delta = 0.95),
  backend = "cmdstanr"
)
```

```{r}
summary(foul_binomial_model_default)
summary(foul_binomial_model_standardized)
summary(foul_binomial_model_mo)
# Check model diagnostics
plot(foul_binomial_model_default)
plot(foul_binomial_model_standardized)
plot(foul_binomial_model_mo)

# Posterior predictive checks
pp_check(foul_binomial_model_default, type = "dens_overlay", ndraws = 100)
pp_check(foul_binomial_model_standardized, type = "dens_overlay", ndraws = 100)
pp_check(foul_binomial_model_mo, type = "dens_overlay", ndraws = 100)


```

```{r}
loo_foul_binomial_model_default <- loo(foul_binomial_model_default)
loo_foul_binomial_model_standardized <- loo(foul_binomial_model_standardized)
loo_foul_binomial_model_mo <- loo(foul_binomial_model_mo)

loo_compare(foul_binomial_model_standardized, foul_binomial_model_mo)
```



