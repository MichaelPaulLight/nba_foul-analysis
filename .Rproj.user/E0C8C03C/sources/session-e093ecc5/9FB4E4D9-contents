```{r}
library(tidyverse)
library(brms)
library(nanoparquet)
library(here)
library(tidybayes)
```

```{r}
data <- read_parquet(here("02_data", "02-2_data_clean", "shots_defensive_perspective.parquet"))

err_foul_count <- data |> 
  group_by(game_id) |> 
  mutate(max_fouls_in_game = max(defender_foul_count)) |> 
  filter(max_fouls_in_game > 5)

# Create a stratified sample
set.seed(123)

sample_size <- 100000

# Create strata based on key variables
data_sample <- data |> 
  anti_join(err_foul_count, join_by(game_id)) |> 
  select(-defender_height, -defender_weight) |> 
  drop_na() |> 
  # First sample games
  group_by(game_id) |> 
  sample_frac(size = 1)  |>
  ungroup() |> 
  # Then sample within games
  group_by(period, defensive_team, defense_distance_category) |> 
  sample_frac(size = sample_size/nrow(data), replace = FALSE) |> 
  ungroup()

# Check the sample size
nrow(data_sample)

data_sample <- data_sample |> 
  mutate(defender_foul_count = factor(defender_foul_count, 
                                   levels = 0:5,
                                   ordered = TRUE))
```

```{r}
foul_binomial_formula_varying_slopes_mo <- bf(
  shots_defended_made | trials(shots_defended_total) ~ 
    1 + mo(defender_foul_count) +
    (1 + mo(defender_foul_count) | defense_distance_category) +
    (1 + mo(defender_foul_count) | defensive_team) +
    (1 + mo(defender_foul_count) | defender_position) +
    (1 + mo(defender_foul_count) | primary_defender)
)

foul_binomial_formula_varying_slopes_mo_2 <- bf(
  shots_defended_made | trials(shots_defended_total) ~ 
    1 + mo(defender_foul_count) +
    (1 + mo(defender_foul_count) | defense_distance_category) +
    (1 + mo(defender_foul_count) | defensive_team) +
    (1 + mo(defender_foul_count) | defender_position) +
    (1 + mo(defender_foul_count) | primary_defender) +
    (1 | offensive_team)
)

prior_custom_vs_mo <- c(
  prior(normal(0, 1), class = "Intercept"),  # Fixed effects, weakly regularizing
  prior(normal(0.2, 0.5), class = "b", coef = "modefender_foul_count"), # Likely positive effect, likely small
  prior(exponential(1), class = "sd"),
  prior(dirichlet(c(1, 1, 1, 1.5, 1.5)), class = "simo", coef = "modefender_foul_count1"),
  prior(lkj(2), class = "cor")
)
```

```{r}
foul_binomial_model_vs_mo_1 <- brm(
  formula = foul_binomial_formula_varying_slopes_mo,
  data = data_sample,
  family = binomial(link = "logit"),
  prior = prior_custom_vs_mo,
  chains = 4,
  cores = 4,
  iter = 2000,
  warmup = 1000,
  seed = 42,
  control = list(adapt_delta = 0.95),
  backend = "cmdstanr",
  file = ("foul_binomial_model_vs_mo_1_10000.rds")
)

foul_binomial_model_vs_mo_2 <- brm(
  formula = foul_binomial_formula_varying_slopes_mo_2,
  data = data_sample,
  family = binomial(link = "logit"),
  prior = prior_custom_vs_mo,
  chains = 4,
  cores = 4,
  iter = 2000,
  warmup = 1000,
  seed = 42,
  control = list(adapt_delta = 0.95),
  backend = "cmdstanr",
  file = ("foul_binomial_model_vs_mo_2_10000.rds")
)
```

